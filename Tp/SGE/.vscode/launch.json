{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch SGE WebApi",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/WebApi/bin/Debug/net10.0/SGE.WebApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole",
      "launchBrowser": {
        "enabled": true,
        "args": "http://localhost:5000/health"
      }
    }
  ]
}
